# Authentication mode:
# - ai_studio: Google AI Studio API Key (aistudio.google.com)
# - enterprise: Gemini Enterprise / Google Cloud Service Account
GOOGLE_AUTH_MODE=ai_studio

# Google AI Studio authentication
GOOGLE_API_KEY=your_api_key_here

# Gemini Enterprise / Google Cloud Service Account authentication
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_SERVICE_ACCOUNT_FILE=C:\path\to\service-account.json

VEO_MODEL_NAME=veo-3.1-generate-preview
# Optional: text model used only for reference video analysis and prompt/copywriting generation.
# Video generation still uses VEO_MODEL_NAME or config.json current_model.
GEMINI_TEXT_MODEL=gemini-3-flash-preview
# Optional: Override Google GenAI API base URL (e.g., your own gateway/proxy endpoint)
# GOOGLE_GENAI_BASE_URL=https://your-proxy.example.com
# Set your proxy URL here if you are in a restricted network environment (e.g., http://127.0.0.1:7890)
# HTTPS_PROXY=http://127.0.0.1:7890
